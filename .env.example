NODE_ENV=development
PORT=3000
API_PREFIX=api/v1

MONGODB_URI=mongodb://localhost:27017/folgar-qa
REDIS_URL=redis://localhost:6379
QUEUE_MODE=inline

JWT_SECRET=dev-secret-please-change-1234567890
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=dev-refresh-secret-please-change-1234567890
JWT_REFRESH_EXPIRES_IN=7d

CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
FRONTEND_URL=http://localhost:5173

# OAuth social login. Crear credenciales reales en cada proveedor y registrar
# estos callback URLs:
# Google:   http://localhost:3000/api/v1/auth/google/callback
# LinkedIn: http://localhost:3000/api/v1/auth/linkedin/callback
# Apple:    http://localhost:3000/api/v1/auth/apple/callback
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_CALLBACK_URL=http://localhost:3000/api/v1/auth/google/callback
LINKEDIN_OAUTH_CLIENT_ID=
LINKEDIN_OAUTH_CLIENT_SECRET=
LINKEDIN_OAUTH_CALLBACK_URL=http://localhost:3000/api/v1/auth/linkedin/callback
APPLE_OAUTH_CLIENT_ID=
APPLE_OAUTH_CLIENT_SECRET=
APPLE_OAUTH_TEAM_ID=
APPLE_OAUTH_KEY_ID=
APPLE_OAUTH_PRIVATE_KEY=
APPLE_OAUTH_CALLBACK_URL=http://localhost:3000/api/v1/auth/apple/callback

# Límite global por IP, aplicado a TODA la API (`ThrottlerGuard` como APP_GUARD
# en app.module.ts) — 20 cada 60s alcanzaba de sobra para pegarle a un único
# endpoint suelto, pero una sola carga de "Inicio" (Dashboard) ya dispara ~6
# GET en paralelo (clientes/facturas/vencimientos/notificaciones/extractos/
# kanban) más el perfil que pide el sidebar en cada navegación — cualquier
# sesión real que navegue un par de pantallas en el mismo minuto lo superaba
# y el Frontend mostraba "ThrottlerException: Too Many Requests" con datos
# reales que sí estaban disponibles. `POST /auth/login` tiene su propio límite
# más estricto aparte (ver `@Throttle` en `AuthController.login`), así que
# subir este global no debilita la protección contra fuerza bruta del login.
THROTTLE_TTL=60000
THROTTLE_LIMIT=300

# En development queda apagado para que la terminal no se llene con cada
# request del Frontend. Usar true/1 solo cuando haya que depurar trafico HTTP.
HTTP_LOGS=false

# Proveedor de IA compartido por extractos-ia (estructurar movimientos de un
# PDF) e iva-tareas (leer un documento y proponer tareas para "Importar
# tareas desde documento"). 'stub' (default) no requiere credenciales.
# 'anthropic' usa Claude Sonnet 5 — requiere ANTHROPIC_API_KEY. 'openai' usa
# GPT-5.1 (u otro modelo vía OPENAI_MODEL) — requiere OPENAI_API_KEY.
AI_PROVIDER=stub
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-5.1

# SMTP real para el envío de mail transaccional (`MailService`) — hoy solo las
# "credenciales de acceso" que se generan al crear un integrante de Personal o
# el usuario de portal de un Cliente (checkbox "Crear usuario y enviarle las
# credenciales por email" en el alta). Sin estas 3 variables, el envío queda
# en modo "solo log" (ver `MailService`), no hace falta para levantar el
# Backend en dev. Con Gmail/Google Workspace: SMTP_HOST=smtp.gmail.com,
# SMTP_PORT=587, SMTP_USER=la casilla remitente, SMTP_PASS=una contraseña de
# aplicación (NO la contraseña normal de la cuenta) generada en
# myaccount.google.com/apppasswords para esa casilla.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=Estudio@folgar.com.ar
SMTP_PASS=
SMTP_FROM=Estudio@folgar.com.ar

# Clave simétrica (32 bytes en base64) para cifrar secretos guardados en Mongo
# (hoy: las API keys de IA que el estudio conecta en Configuración →
# Integraciones). Generar una propia con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SECRETS_ENCRYPTION_KEY=
